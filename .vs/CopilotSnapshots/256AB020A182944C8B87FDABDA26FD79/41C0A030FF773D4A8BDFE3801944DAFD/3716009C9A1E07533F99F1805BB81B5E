using Diet_calulator.ViewModels;
using Diet_calulator.Models;

namespace Diet_calulator.Views
{
    public partial class MetabolismPage : ContentPage
    {
        private MetabolismViewModel _viewModel;

        public MetabolismPage()
        {
            InitializeComponent();
            _viewModel = new MetabolismViewModel();
            BindingContext = _viewModel;
            UpdateWeightUnitButtons();
        }

        private void UpdateWeightUnitButtons()
        {
            if (_viewModel.WeightUnit == "kg")
            {
                KgButton.BackgroundColor = Color.Parse("#95E1D3");
                KgButton.TextColor = Colors.White;
                LbsButton.BackgroundColor = Color.Parse("#E0E0E0");
                LbsButton.TextColor = Color.Parse("#333333");
            }
            else
            {
                KgButton.BackgroundColor = Color.Parse("#E0E0E0");
                KgButton.TextColor = Color.Parse("#333333");
                LbsButton.BackgroundColor = Color.Parse("#95E1D3");
                LbsButton.TextColor = Colors.White;
            }
        }

        private void OnKgClicked(object sender, EventArgs e)
        {
            _viewModel.WeightUnit = "kg";
            UpdateWeightUnitButtons();
        }

        private void OnLbsClicked(object sender, EventArgs e)
        {
            _viewModel.WeightUnit = "lbs";
            UpdateWeightUnitButtons();
        }

        private async void OnInfoClicked(object sender, EventArgs e)
        {
            await DisplayAlert(
                "How to Use - Metabolism Calculator",
                "1. Select your weight unit (kg or lbs)\n\n" +
                "2. Enter your STARTING weight at the beginning of the measurement period\n\n" +
                "3. Enter your ENDING weight after the measurement period. Note: More weeks gives more accurate results\n\n" +
                "4. Select the number of WEEKS (2, 3, or 4)\n\n" +
                "5. Enter your AVERAGE daily calorie intake. Note: The more precisely you measure your intake, the more accurate the calculation\n\n" +
                "6. (Optional) Enter total CARDIO calories burned during the period. Including cardio makes the calculation more independent of cardio activity. Leave empty if not tracking cardio\n\n" +
                "The calculator will compute your actual metabolism based on real weight changes.",
                "Got it");
        }

        private async void OnSaveClicked(object sender, EventArgs e)
        {
            var name = await DisplayPromptAsync(
                "Save Calculation",
                "Enter a name for this calculation:",
                "Save",
                "Cancel",
                "e.g., Week 1 Measurement");

            if (!string.IsNullOrWhiteSpace(name))
            {
                await _viewModel.SaveCalculationAsync(name);
                await DisplayAlert("Success", "Calculation saved successfully", "OK");
            }
        }

        private async void OnLoadClicked(object sender, EventArgs e)
        {
            var calculations = await _viewModel.GetSavedCalculationsAsync();

            if (calculations.Count == 0)
            {
                await DisplayAlert("No Calculations", "You haven't saved any calculations yet", "OK");
                return;
            }

            // Create a custom dialog with delete buttons
            await ShowLoadDialog(calculations);
        }

        private async Task ShowLoadDialog(List<SavedCalculation> calculations)
        {
            var selectedCalculation = await DisplayActionSheet(
                "Load Calculation",
                "Cancel",
                null,
                calculations.Select(c => $"{c.Name} ({c.SavedDate:d})").ToArray());

            if (selectedCalculation == null || selectedCalculation == "Cancel")
                return;

            var selected = calculations.FirstOrDefault(c => $"{c.Name} ({c.SavedDate:d})" == selectedCalculation);
            if (selected != null)
            {
                await _viewModel.LoadCalculationAsync(selected.Id);
                UpdateWeightUnitButtons();

                // Ask for confirmation before loading
                var shouldLoad = await DisplayAlert(
                    "Loaded",
                    $"Calculation '{selected.Name}' loaded successfully",
                    "OK",
                    "Cancel");
            }
        }
    }
}
