<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Diet_calulator.Views.MetabolismPage"
             Title="Metabolism Calculator"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Info Button -->
            <Button Text="How to use" 
                    Clicked="OnInfoClicked"
                    BackgroundColor="#4ECDC4"
                    TextColor="White"
                    Padding="10,5"
                    HorizontalOptions="Start"/>

            <!-- Weight Unit -->
            <VerticalStackLayout Spacing="8">
                <HorizontalStackLayout Spacing="5" VerticalOptions="Center" HorizontalOptions="Start">
                    <Label Text="Weight Unit:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Button Text="kg" 
                            Clicked="OnKgClicked"
                            x:Name="KgButton"
                            BackgroundColor="#95E1D3"
                            TextColor="White"
                            Padding="15,5"
                            HorizontalOptions="Start"/>
                    <Button Text="lbs" 
                            Clicked="OnLbsClicked"
                            x:Name="LbsButton"
                            BackgroundColor="#E0E0E0"
                            TextColor="#333333"
                            Padding="15,5"
                            HorizontalOptions="Start"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Starting Weight -->
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center" HorizontalOptions="Start">
                <Label Text="Starting Weight:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" WidthRequest="140"/>
                <Label x:Name="StartWeightDisplay"
                       Text="{Binding StartWeight, StringFormat='{0:F0}'}"
                       FontSize="16"
                       VerticalOptions="Center"
                       WidthRequest="50"
                       HorizontalOptions="Start"
                       BackgroundColor="Transparent">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnStartWeightTapped"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="{Binding WeightUnit}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Start"/>
            </HorizontalStackLayout>

            <!-- Ending Weight -->
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center" HorizontalOptions="Start">
                <Label Text="Ending Weight:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" WidthRequest="140"/>
                <Label x:Name="EndWeightDisplay"
                       Text="{Binding EndWeight, StringFormat='{0:F0}'}"
                       FontSize="16"
                       VerticalOptions="Center"
                       WidthRequest="50"
                       HorizontalOptions="Start"
                       BackgroundColor="Transparent">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEndWeightTapped"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="{Binding WeightUnit}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Start"/>
            </HorizontalStackLayout>

            <!-- Average kcal per day -->
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center" HorizontalOptions="Start">
                <Label Text="Average kcal/day:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" WidthRequest="140"/>
                <Label x:Name="KcalDisplay"
                       Text="{Binding KcalPerDay, StringFormat='{0:F0}'}"
                       FontSize="16"
                       VerticalOptions="Center"
                       WidthRequest="80"
                       HorizontalOptions="Start"
                       BackgroundColor="Transparent">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnKcalTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <!-- Weeks -->
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center" HorizontalOptions="Start">
                <Label Text="Weeks:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" WidthRequest="140"/>
                <Label x:Name="WeeksDisplay"
                       Text="{Binding Weeks}"
                       FontSize="16"
                       VerticalOptions="Center"
                       WidthRequest="50"
                       HorizontalOptions="Start"
                       BackgroundColor="Transparent">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnWeeksTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <!-- Cardio (optional) -->
            <VerticalStackLayout Spacing="5">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center" HorizontalOptions="Start">
                    <Label Text="Cardio:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" WidthRequest="140"/>
                    <Label x:Name="CardioDisplay"
                           Text="{Binding CardioKcal, StringFormat='{0:F0}'}"
                           FontSize="16"
                           VerticalOptions="Center"
                           WidthRequest="50"
                           HorizontalOptions="Start"
                           BackgroundColor="Transparent">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCardioTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="kcal/week" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Start"/>
                </HorizontalStackLayout>
                <Label FontSize="12" TextColor="#666666">Tap to edit (leave empty if not tracking)</Label>
            </VerticalStackLayout>

            <!-- Hidden Entry for numeric input -->
            <Entry x:Name="HiddenEntry"
                   Keyboard="Numeric"
                   IsVisible="True"
                   BackgroundColor="Transparent"
                   Opacity="0"
                   HeightRequest="0"/>

            <!-- Result -->
            <Frame BorderColor="#FF6B6B" CornerRadius="10" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Calculated Metabolism" FontSize="18" FontAttributes="Bold" />
                    
                    <Label FontSize="16">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Metabolism, StringFormat='{0:D}'}" FontSize="24" FontAttributes="Bold" />
                                <Span Text=" kcal/" FontSize="14" />
                                <Span Text="{Binding WeightUnit}" FontSize="14" />
                                <Span Text="/day" FontSize="14" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    
                    <Label FontSize="12" TextColor="#666666">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Based on weight from " />
                                <Span Text="{Binding StartWeight, StringFormat='{0:F0}'}" FontAttributes="Bold" />
                                <Span Text=" to " />
                                <Span Text="{Binding EndWeight, StringFormat='{0:F0}'}" FontAttributes="Bold" />
                                <Span Text=" over " />
                                <Span Text="{Binding Weeks}" FontAttributes="Bold" />
                                <Span Text=" weeks" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Frame>

            <!-- Save/Load Buttons at Bottom -->
            <HorizontalStackLayout Spacing="10">
                <Button Text="Save" 
                        Clicked="OnSaveClicked"
                        BackgroundColor="#95E1D3"
                        TextColor="White"
                        HorizontalOptions="FillAndExpand"/>
                <Button Text="Load" 
                        Clicked="OnLoadClicked"
                        BackgroundColor="#95E1D3"
                        TextColor="White"
                        HorizontalOptions="FillAndExpand"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
