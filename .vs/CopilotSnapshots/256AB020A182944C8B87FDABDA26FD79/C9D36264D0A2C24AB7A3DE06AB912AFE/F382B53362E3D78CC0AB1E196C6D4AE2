<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Diet_calulator.Views.MetabolismPage"
             Title="Metabolism Calculator"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Info Button - back to left -->
            <Button Text="How to use" 
                    Clicked="OnInfoClicked"
                    BackgroundColor="#4ECDC4"
                    TextColor="White"
                    Padding="10,5"
                    FontSize="14"
                    HorizontalOptions="Start"/>

            <!-- Weight Unit -->
            <VerticalStackLayout Spacing="14">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Start">
                    <Label Text="Weight Unit:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="KgLabel"
                           Text="kg" FontSize="16" VerticalOptions="Center" TextColor="Black"/>
                    <Switch x:Name="WeightUnitSwitch"
                            IsToggled="False"
                            Toggled="OnWeightUnitToggled"
                            VerticalOptions="Center"
                            ThumbColor="#4ECDC4"
                            OnColor="#E0E0E0"
                            OffColor="#E0E0E0"/>
                    <Label x:Name="LbsLabel"
                           Text="lbs" FontSize="16" VerticalOptions="Center" TextColor="#CCCCCC"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Input Section - moved up more -->
            <VerticalStackLayout Spacing="22" Margin="0,-20,0,0">
                <!-- Starting Weight -->
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Start">
                    <Label Text="Starting Weight:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="StartWeightDisplay"
                           Text="{Binding StartWeight, StringFormat='{0:F0}'}"
                           FontSize="16"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"
                           BackgroundColor="Transparent">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStartWeightTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="{Binding WeightUnit}" FontSize="16" VerticalOptions="Center" HorizontalOptions="Start" TextColor="#666666"/>
                </HorizontalStackLayout>

                <!-- Ending Weight -->
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Start">
                    <Label Text="Ending Weight:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="EndWeightDisplay"
                           Text="{Binding EndWeight, StringFormat='{0:F0}'}"
                           FontSize="16"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"
                           BackgroundColor="Transparent">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEndWeightTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="{Binding WeightUnit}" FontSize="16" VerticalOptions="Center" HorizontalOptions="Start" TextColor="#666666"/>
                </HorizontalStackLayout>

                <!-- Average kcal per day -->
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Start">
                    <Label Text="Average kcal/day:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="KcalDisplay"
                           Text="{Binding KcalPerDay, StringFormat='{0:F0}'}"
                           FontSize="16"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"
                           BackgroundColor="Transparent">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnKcalTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <!-- Weeks -->
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Start">
                    <Label Text="Weeks:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="WeeksDisplay"
                           Text="{Binding Weeks}"
                           FontSize="16"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"
                           BackgroundColor="Transparent">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnWeeksTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <!-- Cardio (optional) -->
                <VerticalStackLayout Spacing="6">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Start">
                        <Label Text="Cardio:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Label x:Name="CardioDisplay"
                               Text="{Binding CardioKcal, StringFormat='{0:F0}'}"
                               FontSize="16"
                               VerticalOptions="Center"
                               HorizontalOptions="Start"
                               BackgroundColor="Transparent">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCardioTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="kcal/week" FontSize="16" VerticalOptions="Center" HorizontalOptions="Start" TextColor="#666666"/>
                    </HorizontalStackLayout>
                    <Label FontSize="11" TextColor="#999999" Margin="0,2,0,0">Tap to edit (leave empty if not tracking)</Label>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Hidden Entry for numeric input -->
            <Entry x:Name="HiddenEntry"
                   Keyboard="Numeric"
                   IsVisible="True"
                   BackgroundColor="Transparent"
                   Opacity="0"
                   HeightRequest="0"/>

            <!-- Result - reduced margin before and spacing reduced ~30% -->
            <Frame BorderColor="#FF6B6B" CornerRadius="10" Padding="15" HasShadow="True" Margin="0,15,0,0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Calculated Metabolism" FontSize="16" FontAttributes="Bold" />
                    
                    <Label FontSize="14">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Metabolism, StringFormat='{0:D}'}" FontSize="28" FontAttributes="Bold" />
                                <Span Text=" kcal/" FontSize="12" />
                                <Span Text="{Binding WeightUnit}" FontSize="12" />
                                <Span Text="/day" FontSize="12" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    
                    <Label FontSize="11" TextColor="#666666">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Based on weight from " />
                                <Span Text="{Binding StartWeight, StringFormat='{0:F0}'}" FontAttributes="Bold" />
                                <Span Text=" to " />
                                <Span Text="{Binding EndWeight, StringFormat='{0:F0}'}" FontAttributes="Bold" />
                                <Span Text=" over " />
                                <Span Text="{Binding Weeks}" FontAttributes="Bold" />
                                <Span Text=" weeks" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Frame>

            <!-- Spacer to push buttons to bottom -->
            <BoxView Color="Transparent" VerticalOptions="FillAndExpand"/>

            <!-- Save/Load Buttons at Bottom -->
            <HorizontalStackLayout Spacing="13" Margin="0,0,0,0" HorizontalOptions="Center">
                <Button Text="Save" 
                        Clicked="OnSaveClicked"
                        BackgroundColor="#95E1D3"
                        TextColor="White"
                        FontSize="14"
                        Padding="20,10"
                        WidthRequest="100"/>
                <Button Text="Load" 
                        Clicked="OnLoadClicked"
                        BackgroundColor="#95E1D3"
                        TextColor="White"
                        FontSize="14"
                        Padding="20,10"
                        WidthRequest="100"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
