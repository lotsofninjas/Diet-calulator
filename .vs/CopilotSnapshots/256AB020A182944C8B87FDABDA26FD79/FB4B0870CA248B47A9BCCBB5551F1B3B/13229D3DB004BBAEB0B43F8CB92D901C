        [Fact]
        public async Task SaveCalculationAsync_CreatesValidCalculation()
        {
            // Arrange
            var viewModel = new MetabolismViewModel();
            viewModel.StartWeight = 80;
            viewModel.EndWeight = 75;
            viewModel.Weeks = 2;
            viewModel.KcalPerDay = 2000;
            viewModel.CardioKcal = 100;
            viewModel.WeightUnit = "kg";

            // Act
            await viewModel.SaveCalculationAsync("Test Calculation");
            var saved = await viewModel.GetSavedCalculationsAsync();

            // Assert
            Assert.NotEmpty(saved);
            var lastCalc = saved.LastOrDefault();
            Assert.NotNull(lastCalc);
            Assert.Equal("Test Calculation", lastCalc.Name);
            Assert.Equal("Metabolism", lastCalc.Type);
        }

        [Fact]
        public async Task LoadCalculationAsync_LoadsCorrectValues()
        {
            // Arrange
            var viewModel = new MetabolismViewModel();
            await viewModel.SaveCalculationAsync("Load Test");
            var saved = await viewModel.GetSavedCalculationsAsync();
            var calcId = saved.First().Id;

            viewModel.StartWeight = 90;
            viewModel.EndWeight = 85;
            viewModel.Weeks = 3;

            // Act
            await viewModel.LoadCalculationAsync(calcId);

            // Assert
            Assert.Equal(80, viewModel.StartWeight);
            Assert.Equal(75, viewModel.EndWeight);
            Assert.Equal(2, viewModel.Weeks);
        }

        [Fact]
        public async Task DeleteCalculationAsync_RemovesCalculation()
        {
            // Arrange
            var viewModel = new MetabolismViewModel();
            await viewModel.SaveCalculationAsync("Delete Test");
            var saved = await viewModel.GetSavedCalculationsAsync();
            var calcId = saved.First().Id;
            var countBefore = saved.Count;

            // Act
            await viewModel.DeleteCalculationAsync(calcId);
            var updated = await viewModel.GetSavedCalculationsAsync();

            // Assert
            Assert.Equal(countBefore - 1, updated.Count);
            Assert.DoesNotContain(updated, c => c.Id == calcId);
        }
    }
