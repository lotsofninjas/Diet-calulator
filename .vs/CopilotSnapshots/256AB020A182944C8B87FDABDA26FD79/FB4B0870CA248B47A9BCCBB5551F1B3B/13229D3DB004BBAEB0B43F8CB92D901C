        [Fact]
        public void MetabolismViewModel_InitializesWithDefaultValues()
        {
            // Arrange & Act
            var viewModel = new MetabolismViewModel();

            // Assert
            Assert.Equal(80, viewModel.StartWeight);
            Assert.Equal(75, viewModel.EndWeight);
            Assert.Equal(2, viewModel.Weeks);
            Assert.Equal(2000, viewModel.KcalPerDay);
            Assert.Equal(0, viewModel.CardioKcal);
            Assert.Equal("kg", viewModel.WeightUnit);
        }

