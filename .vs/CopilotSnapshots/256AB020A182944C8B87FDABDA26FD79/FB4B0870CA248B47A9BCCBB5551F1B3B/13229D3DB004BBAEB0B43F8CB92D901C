        [Fact]
        public void Metabolism_CalculatesCorrectly()
        {
            // Arrange
            var viewModel = new MetabolismViewModel();
            viewModel.StartWeight = 80;
            viewModel.EndWeight = 75;
            viewModel.Weeks = 2;
            viewModel.KcalPerDay = 2000;
            viewModel.CardioKcal = 0;
            viewModel.WeightUnit = "kg";

            // Act
            // Metabolism should be calculated automatically when properties change

            // Assert
            Assert.True(viewModel.Metabolism >= 0);
            Assert.True(viewModel.Metabolism < 10000); // Sanity check
        }

