            var viewModel = new MacroViewModel();

            // Assert
            Assert.Equal("Maintain", viewModel.Mode);
            Assert.Equal("Preset", viewModel.MacroInputMode);
            Assert.Equal("Same Everyday", viewModel.EatingPattern);
            Assert.Equal(80, viewModel.Weight);
            Assert.Equal(25, viewModel.Metabolism);
            Assert.Equal("Balanced", viewModel.PresetProfile);
        }

