        [Fact]
        public async Task SaveCalculationAsync_SavesAllProperties()
        {
            // Arrange
            var viewModel = new MacroViewModel();
            viewModel.Mode = "Bulk";
            viewModel.Weight = 85;
            viewModel.Metabolism = 26;
            viewModel.ChangePerWeek = 0.4;

            // Act
            await viewModel.SaveCalculationAsync("Bulk Test");
            var saved = await viewModel.GetSavedCalculationsAsync();

            // Assert
            Assert.NotEmpty(saved);
            var lastCalc = saved.LastOrDefault();
            Assert.NotNull(lastCalc);
            Assert.Equal("Bulk Test", lastCalc.Name);
            Assert.Equal("Macro", lastCalc.Type);
        }

        [Fact]
        public async Task LoadCalculationAsync_LoadsAllProperties()
        {
            // Arrange
            var viewModel = new MacroViewModel();
            viewModel.Mode = "Bulk";
            viewModel.Weight = 90;
            viewModel.Metabolism = 26;
            await viewModel.SaveCalculationAsync("Load Test");
            var saved = await viewModel.GetSavedCalculationsAsync();
            var calcId = saved.First().Id;

            // Change values
            viewModel.Mode = "Maintain";
            viewModel.Weight = 80;

            // Act
            await viewModel.LoadCalculationAsync(calcId);

            // Assert
            Assert.Equal("Bulk", viewModel.Mode);
            Assert.Equal(90, viewModel.Weight);
            Assert.Equal(26, viewModel.Metabolism);
        }

        [Fact]
        public async Task DeleteCalculationAsync_RemovesCalculation()
        {
            // Arrange
            var viewModel = new MacroViewModel();
            await viewModel.SaveCalculationAsync("Delete Test");
            var saved = await viewModel.GetSavedCalculationsAsync();
            var calcId = saved.First().Id;
            var countBefore = saved.Count;

            // Act
            await viewModel.DeleteCalculationAsync(calcId);
            var updated = await viewModel.GetSavedCalculationsAsync();

            // Assert
            Assert.Equal(countBefore - 1, updated.Count);
        }

