        [Fact]
        public void EatingPattern_TrainingDays_DifferentMacrosOnRestDays()
        {
            // Arrange
            var viewModel = new MacroViewModel();
            viewModel.EatingPattern = "Training Days";
            viewModel.TrainingDaysPerWeek = 4;

            // Act
