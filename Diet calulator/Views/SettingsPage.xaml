<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Diet_calulator.Views.SettingsPage"
             Title="Settings"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Units Section -->
            <Frame BorderColor="#E0E0E0" CornerRadius="12" Padding="20" HasShadow="False">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Units" FontSize="16" FontAttributes="Bold" TextColor="#000000"/>
                    
                    <!-- Weight Unit -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Weight" FontSize="14" FontAttributes="Bold" TextColor="#666666"/>
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Label x:Name="KgLabel" Text="kg" FontSize="13" VerticalOptions="Center" TextColor="Black" FontAttributes="Bold" WidthRequest="40"/>
                            <Switch x:Name="WeightUnitSwitch" Toggled="OnWeightUnitToggled" VerticalOptions="Center" ThumbColor="#4ECDC4" OnColor="#4ECDC4" OffColor="#E0E0E0"/>
                            <Label x:Name="LbsLabel" Text="lbs" FontSize="13" VerticalOptions="Center" TextColor="#CCCCCC" FontAttributes="Bold" HorizontalOptions="EndAndExpand"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Distance Unit -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Distance" FontSize="14" FontAttributes="Bold" TextColor="#666666"/>
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Label x:Name="KmLabel" Text="km" FontSize="13" VerticalOptions="Center" TextColor="Black" FontAttributes="Bold" WidthRequest="40"/>
                            <Switch x:Name="DistanceUnitSwitch" Toggled="OnDistanceUnitToggled" VerticalOptions="Center" ThumbColor="#4ECDC4" OnColor="#4ECDC4" OffColor="#E0E0E0"/>
                            <Label x:Name="MilesLabel" Text="miles" FontSize="13" VerticalOptions="Center" TextColor="#CCCCCC" FontAttributes="Bold" HorizontalOptions="EndAndExpand"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Info Section -->
            <Frame BorderColor="#E0E0E0" CornerRadius="12" Padding="20" HasShadow="False">
                <VerticalStackLayout Spacing="12">
                    <Label Text="About" FontSize="16" FontAttributes="Bold" TextColor="#000000"/>
                    <Label Text="Diet Calculator v1.0" FontSize="14" TextColor="#666666"/>
                    <Label Text="Macro &amp; Nutrition Planner" FontSize="12" TextColor="#999999"/>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
