<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Diet_calulator.Views.MacroPage"
             Title="Macro Calculator"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*" Padding="20,20,20,0" RowSpacing="20">
        <!-- Header Row - Mode Selection Buttons -->
        <HorizontalStackLayout Grid.Row="0" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
            <Button x:Name="MaintainButton"
                    Text="Maintain"
                    Clicked="OnMaintainClicked"
                    BackgroundColor="#95E1D3"
                    TextColor="White"
                    Padding="15,8"
                    FontSize="14"
                    WidthRequest="100"/>
            <Button x:Name="BulkButton"
                    Text="Bulk"
                    Clicked="OnBulkClicked"
                    BackgroundColor="#E0E0E0"
                    TextColor="#666666"
                    Padding="15,8"
                    FontSize="14"
                    WidthRequest="100"/>
            <Button x:Name="CutButton"
                    Text="Cut"
                    Clicked="OnCutClicked"
                    BackgroundColor="#E0E0E0"
                    TextColor="#666666"
                    Padding="15,8"
                    FontSize="14"
                    WidthRequest="100"/>
        </HorizontalStackLayout>

        <!-- Scrollable Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="0,0,20,0" Spacing="20" Margin="0,20,0,0">
                
                <!-- Input Mode Selection -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Macro Input:" FontSize="16" FontAttributes="Bold" />
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Start">
                        <Label x:Name="PresetLabel"
                               Text="Preset" FontSize="14" VerticalOptions="Center" TextColor="Black" FontAttributes="Bold"/>
                        <Switch x:Name="MacroInputSwitch"
                                IsToggled="False"
                                Toggled="OnMacroInputToggled"
                                VerticalOptions="Center"
                                ThumbColor="#4ECDC4"
                                OnColor="#E0E0E0"
                                OffColor="#E0E0E0"/>
                        <Label x:Name="CustomLabel"
                               Text="Custom" FontSize="14" VerticalOptions="Center" TextColor="#CCCCCC" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Weight Input -->
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Start">
                    <Label Text="Weight:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="WeightDisplay"
                           Text="{Binding Weight, StringFormat='{0:F1}'}"
                           FontSize="16"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"
                           BackgroundColor="Transparent">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnWeightTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="kg" FontSize="16" VerticalOptions="Center" HorizontalOptions="Start" TextColor="#666666"/>
                </HorizontalStackLayout>

                <!-- Metabolism Input -->
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Start">
                    <Label Text="Metabolism:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="MetabolismDisplay"
                           Text="{Binding Metabolism, StringFormat='{0:F2}'}"
                           FontSize="16"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"
                           BackgroundColor="Transparent">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMetabolismTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="kcal/kg" FontSize="16" VerticalOptions="Center" HorizontalOptions="Start" TextColor="#666666"/>
                </HorizontalStackLayout>

                <!-- Custom Macro Inputs (conditional) -->
                <VerticalStackLayout x:Name="CustomMacroSection" Spacing="8" IsVisible="False">
                    <Label Text="Custom Macros:" FontSize="14" FontAttributes="Bold" Margin="0,10,0,0"/>
                    
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Start">
                        <Label Text="Protein:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Label x:Name="ProteinPerKgDisplay"
                               Text="{Binding ProteinPerKg, StringFormat='{0:F2}'}"
                               FontSize="16"
                               VerticalOptions="Center"
                               HorizontalOptions="Start"
                               BackgroundColor="Transparent">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnProteinPerKgTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="g/kg" FontSize="16" VerticalOptions="Center" HorizontalOptions="Start" TextColor="#666666"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Start">
                        <Label Text="Fat:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Label x:Name="FatPerKgDisplay"
                               Text="{Binding FatPerKg, StringFormat='{0:F2}'}"
                               FontSize="16"
                               VerticalOptions="Center"
                               HorizontalOptions="Start"
                               BackgroundColor="Transparent">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFatPerKgTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="g/kg" FontSize="16" VerticalOptions="Center" HorizontalOptions="Start" TextColor="#666666"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Preset Profile Selection (conditional) -->
                <VerticalStackLayout x:Name="PresetSection" Spacing="8">
                    <Label Text="Preset Profile:" FontSize="14" FontAttributes="Bold" Margin="0,10,0,0"/>
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Start">
                        <Label x:Name="PresetProfileDisplay"
                               Text="{Binding PresetProfile}"
                               FontSize="14"
                               VerticalOptions="Center"
                               HorizontalOptions="Start"
                               BackgroundColor="Transparent"
                               TextColor="Black">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPresetProfileTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Eating Pattern Selection -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Eating Pattern:" FontSize="14" FontAttributes="Bold" Margin="0,10,0,0"/>
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Start">
                        <Label x:Name="SameEverydayLabel"
                               Text="Same Everyday" FontSize="14" VerticalOptions="Center" TextColor="Black" FontAttributes="Bold"/>
                        <Switch x:Name="EatingPatternSwitch"
                                IsToggled="False"
                                Toggled="OnEatingPatternToggled"
                                VerticalOptions="Center"
                                ThumbColor="#4ECDC4"
                                OnColor="#E0E0E0"
                                OffColor="#E0E0E0"/>
                        <Label x:Name="TrainingDaysLabel"
                               Text="Training Days" FontSize="14" VerticalOptions="Center" TextColor="#CCCCCC" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Training Days Selection (conditional) -->
                <VerticalStackLayout x:Name="TrainingDaysSection" Spacing="8" IsVisible="False">
                    <Label Text="Training Days/Week:" FontSize="14" FontAttributes="Bold" Margin="0,10,0,0"/>
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Start">
                        <Label x:Name="TrainingDaysDisplay"
                               Text="{Binding TrainingDaysPerWeek, StringFormat='{0}'}"
                               FontSize="14"
                               VerticalOptions="Center"
                               HorizontalOptions="Start"
                               BackgroundColor="Transparent"
                               TextColor="Black">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTrainingDaysTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Cardio Input -->
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Start">
                    <Label Text="Cardio:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="CardioDisplay"
                           Text="{Binding Cardio, StringFormat='{0:F0}'}"
                           FontSize="16"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"
                           BackgroundColor="Transparent">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCardioTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="kcal/week" FontSize="16" VerticalOptions="Center" HorizontalOptions="Start" TextColor="#666666"/>
                </HorizontalStackLayout>

                <!-- Snacks Input (Bulk only) -->
                <VerticalStackLayout x:Name="SnacksSection" Spacing="8" IsVisible="False">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Start">
                        <Label Text="Snacks:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Label x:Name="SnacksDisplay"
                               Text="{Binding Snacks, StringFormat='{0:F0}'}"
                               FontSize="16"
                               VerticalOptions="Center"
                               HorizontalOptions="Start"
                               BackgroundColor="Transparent">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSnacksTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="kcal/week" FontSize="16" VerticalOptions="Center" HorizontalOptions="Start" TextColor="#666666"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Change Per Week Selection (Bulk/Cut only) -->
                <VerticalStackLayout x:Name="ChangePerWeekSection" Spacing="8" IsVisible="False">
                    <Label Text="Change Per Week:" FontSize="14" FontAttributes="Bold" Margin="0,10,0,0"/>
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Start">
                        <Label x:Name="ChangePerWeekDisplay"
                               Text="{Binding ChangePerWeek, StringFormat='{0:F2}'}"
                               FontSize="14"
                               VerticalOptions="Center"
                               HorizontalOptions="Start"
                               BackgroundColor="Transparent"
                               TextColor="Black">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChangePerWeekTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Hidden Entry for numeric input -->
                <Entry x:Name="HiddenEntry"
                       Keyboard="Numeric"
                       IsVisible="True"
                       BackgroundColor="Transparent"
                       Opacity="0"
                       HeightRequest="0"/>

                <!-- Results Section -->
                <Frame BorderColor="#4ECDC4" CornerRadius="10" Padding="15" HasShadow="True" Margin="0,20,0,0">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="Results" FontSize="16" FontAttributes="Bold" />
                        
                        <!-- Daily/Average Calories -->
                        <Frame BorderColor="#E0E0E0" CornerRadius="8" Padding="12" HasShadow="False">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Daily Calories" FontSize="14" FontAttributes="Bold" />
                                <Label FontSize="20" FontAttributes="Bold">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding DailyCalories}" />
                                            <Span Text=" kcal" FontSize="14" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Macros for Same Everyday or Average -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Daily Macros" FontSize="14" FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Start">
                                <Frame BorderColor="#FFD700" CornerRadius="8" Padding="10" HasShadow="False" WidthRequest="100">
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="Protein" FontSize="12" HorizontalOptions="Center" />
                                        <Label Text="{Binding Protein, StringFormat='{0}g'}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Frame>
                                <Frame BorderColor="#FF6B6B" CornerRadius="8" Padding="10" HasShadow="False" WidthRequest="100">
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="Carbs" FontSize="12" HorizontalOptions="Center" />
                                        <Label Text="{Binding Carbs, StringFormat='{0}g'}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Frame>
                                <Frame BorderColor="#95E1D3" CornerRadius="8" Padding="10" HasShadow="False" WidthRequest="100">
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="Fat" FontSize="12" HorizontalOptions="Center" />
                                        <Label Text="{Binding Fat, StringFormat='{0}g'}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Frame>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- Training Day Macros (conditional) -->
                        <VerticalStackLayout x:Name="TrainingDaySection" Spacing="8" IsVisible="False" Margin="0,10,0,0">
                            <Label Text="Training Days" FontSize="14" FontAttributes="Bold" />
                            <Label Text="{Binding TrainingDayCalories, StringFormat='Calories: {0} kcal'}" FontSize="13" />
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Start">
                                <Frame BorderColor="#FFD700" CornerRadius="8" Padding="10" HasShadow="False" WidthRequest="100">
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="Protein" FontSize="12" HorizontalOptions="Center" />
                                        <Label Text="{Binding TrainingDayProtein, StringFormat='{0}g'}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Frame>
                                <Frame BorderColor="#FF6B6B" CornerRadius="8" Padding="10" HasShadow="False" WidthRequest="100">
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="Carbs" FontSize="12" HorizontalOptions="Center" />
                                        <Label Text="{Binding TrainingDayCarbs, StringFormat='{0}g'}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Frame>
                                <Frame BorderColor="#95E1D3" CornerRadius="8" Padding="10" HasShadow="False" WidthRequest="100">
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="Fat" FontSize="12" HorizontalOptions="Center" />
                                        <Label Text="{Binding TrainingDayFat, StringFormat='{0}g'}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Frame>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- Rest Day Macros (conditional) -->
                        <VerticalStackLayout x:Name="RestDaySection" Spacing="8" IsVisible="False" Margin="0,10,0,0">
                            <Label Text="Rest Days" FontSize="14" FontAttributes="Bold" />
                            <Label Text="{Binding RestDayCalories, StringFormat='Calories: {0} kcal'}" FontSize="13" />
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Start">
                                <Frame BorderColor="#FFD700" CornerRadius="8" Padding="10" HasShadow="False" WidthRequest="100">
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="Protein" FontSize="12" HorizontalOptions="Center" />
                                        <Label Text="{Binding RestDayProtein, StringFormat='{0}g'}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Frame>
                                <Frame BorderColor="#FF6B6B" CornerRadius="8" Padding="10" HasShadow="False" WidthRequest="100">
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="Carbs" FontSize="12" HorizontalOptions="Center" />
                                        <Label Text="{Binding RestDayCarbs, StringFormat='{0}g'}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Frame>
                                <Frame BorderColor="#95E1D3" CornerRadius="8" Padding="10" HasShadow="False" WidthRequest="100">
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="Fat" FontSize="12" HorizontalOptions="Center" />
                                        <Label Text="{Binding RestDayFat, StringFormat='{0}g'}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Frame>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Save/Load Buttons - Fixed at bottom above tab bar -->
        <HorizontalStackLayout Grid.Row="2" Spacing="13" Margin="0,0,20,20" HorizontalOptions="Center">
            <Button Text="Save" 
                    Clicked="OnSaveClicked"
                    BackgroundColor="#95E1D3"
                    TextColor="White"
                    FontSize="14"
                    Padding="20,10"
                    WidthRequest="100"/>
            <Button Text="Load" 
                    Clicked="OnLoadClicked"
                    BackgroundColor="#95E1D3"
                    TextColor="White"
                    FontSize="14"
                    Padding="20,10"
                    WidthRequest="100"/>
        </HorizontalStackLayout>

    </Grid>

</ContentPage>
