<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Diet_calulator.Views.MacroPage"
             Title="Macro Calculator"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*" Padding="20,20,20,0" RowSpacing="20">
        <!-- Header Row - Mode Selection Buttons -->
        <HorizontalStackLayout Grid.Row="0" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
            <Button x:Name="MaintainButton"
                    Text="Maintain"
                    Clicked="OnMaintainClicked"
                    BackgroundColor="#4ECDC4"
                    TextColor="White"
                    Padding="15,8"
                    FontSize="14"
                    FontAttributes="Bold"
                    WidthRequest="100"
                    CornerRadius="8"/>
            <Button x:Name="BulkButton"
                    Text="Bulk"
                    Clicked="OnBulkClicked"
                    BackgroundColor="#E8E8E8"
                    TextColor="#666666"
                    Padding="15,8"
                    FontSize="14"
                    FontAttributes="Bold"
                    WidthRequest="100"
                    CornerRadius="8"/>
            <Button x:Name="CutButton"
                    Text="Cut"
                    Clicked="OnCutClicked"
                    BackgroundColor="#E8E8E8"
                    TextColor="#666666"
                    Padding="15,8"
                    FontSize="14"
                    FontAttributes="Bold"
                    WidthRequest="100"
                    CornerRadius="8"/>
        </HorizontalStackLayout>

        <!-- Scrollable Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="0,0,20,20" Spacing="20" Margin="0,10,0,0">
                
                <!-- Input Mode Selection -->
                <HorizontalStackLayout Spacing="20" VerticalOptions="Center" HorizontalOptions="Fill">
                    <Label Text="Macro Input:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="End">
                        <Label x:Name="PresetLabel"
                               Text="Preset" FontSize="14" VerticalOptions="Center" TextColor="Black" FontAttributes="Bold"/>
                        <Switch x:Name="MacroInputSwitch"
                                IsToggled="False"
                                Toggled="OnMacroInputToggled"
                                VerticalOptions="Center"
                                ThumbColor="#4ECDC4"
                                OnColor="#4ECDC4"
                                OffColor="#E0E0E0"/>
                        <Label x:Name="CustomLabel"
                               Text="Custom" FontSize="14" VerticalOptions="Center" TextColor="#CCCCCC" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                </HorizontalStackLayout>

                <!-- Weight Input -->
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center" HorizontalOptions="Start">
                    <Label Text="Weight:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" WidthRequest="100"/>
                    <Label x:Name="WeightDisplay"
                           Text="{Binding Weight, StringFormat='{0:F1}'}"
                           FontSize="16"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"
                           BackgroundColor="Transparent">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnWeightTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="{Binding WeightUnit}" FontSize="14" VerticalOptions="Center" HorizontalOptions="Start" TextColor="#999999"/>
                </HorizontalStackLayout>

                <!-- Metabolism Input -->
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center" HorizontalOptions="Start">
                    <Label Text="Metabolism:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" WidthRequest="100"/>
                    <Label x:Name="MetabolismDisplay" Text="{Binding MetabolismDisplay, StringFormat='{0}'}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Start" BackgroundColor="Transparent">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMetabolismTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="{Binding MetabolismUnit}" FontSize="14" VerticalOptions="Center" HorizontalOptions="Start" TextColor="#999999"/>
                </HorizontalStackLayout>

                <!-- Custom Macro Inputs (conditional) -->
                <HorizontalStackLayout x:Name="CustomMacroProteinSection" Spacing="12" VerticalOptions="Center" HorizontalOptions="Start" IsVisible="False">
                    <Label Text="Protein:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" WidthRequest="100"/>
                    <Label x:Name="ProteinPerKgDisplay" Text="{Binding ProteinPerKg, StringFormat='{0:F2}'}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Start" BackgroundColor="Transparent">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProteinPerKgTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="g/kg" FontSize="14" VerticalOptions="Center" HorizontalOptions="Start" TextColor="#999999"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout x:Name="CustomMacroFatSection" Spacing="12" VerticalOptions="Center" HorizontalOptions="Start" IsVisible="False">
                    <Label Text="Fat:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" WidthRequest="100"/>
                    <Label x:Name="FatPerKgDisplay" Text="{Binding FatPerKg, StringFormat='{0:F2}'}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Start" BackgroundColor="Transparent">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFatPerKgTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="g/kg" FontSize="14" VerticalOptions="Center" HorizontalOptions="Start" TextColor="#999999"/>
                </HorizontalStackLayout>

                <!-- Preset Profile Selection -->
                <HorizontalStackLayout Spacing="20" VerticalOptions="Center" HorizontalOptions="Fill">
                    <Label Text="Preset Profile:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="PresetProfileDisplay" Text="{Binding PresetProfile}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="End" BackgroundColor="Transparent" TextColor="Black">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPresetProfileTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <!-- Cardio Input -->
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center" HorizontalOptions="Start">
                    <Label Text="Cardio:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" WidthRequest="100"/>
                    <Label x:Name="CardioDisplay" Text="{Binding Cardio, StringFormat='{0:F0}'}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Start" BackgroundColor="Transparent">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCardioTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="kcal/week" FontSize="14" VerticalOptions="Center" HorizontalOptions="Start" TextColor="#999999"/>
                </HorizontalStackLayout>

                <!-- More carbs on training days -->
                <HorizontalStackLayout Spacing="20" VerticalOptions="Center" HorizontalOptions="Fill">
                    <Label Text="More carbs on training days:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Switch x:Name="EatingPatternSwitch" IsToggled="False" Toggled="OnEatingPatternToggled" VerticalOptions="Center" ThumbColor="#4ECDC4" OnColor="#4ECDC4" OffColor="#E0E0E0" HorizontalOptions="End"/>
                </HorizontalStackLayout>

                <!-- Training Days Selection (conditional) -->
                <HorizontalStackLayout x:Name="TrainingPatternSection" Spacing="20" VerticalOptions="Center" HorizontalOptions="Fill" IsVisible="False">
                    <Label Text="Training Days:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="TrainingPatternDisplay" Text="{Binding TrainingPattern}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="End" BackgroundColor="Transparent" TextColor="Black">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTrainingPatternTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <!-- Extra Carbs Input (conditional) -->
                <HorizontalStackLayout x:Name="CarbsMoreSection" Spacing="12" VerticalOptions="Center" HorizontalOptions="Start" IsVisible="False">
                    <Label Text="Extra Carbs:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" WidthRequest="100"/>
                    <Label x:Name="CarbsMoreDisplay" Text="{Binding CarbsMore, StringFormat='{0:F0}'}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Start" BackgroundColor="Transparent">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCarbsMoreTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="g/day" FontSize="14" VerticalOptions="Center" HorizontalOptions="Start" TextColor="#999999"/>
                </HorizontalStackLayout>

                <!-- Snacks Input (Bulk only) -->
                <HorizontalStackLayout x:Name="SnacksSection" Spacing="12" VerticalOptions="Center" HorizontalOptions="Start" IsVisible="False">
                    <Label Text="Snacks:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" WidthRequest="100"/>
                    <Label x:Name="SnacksDisplay" Text="{Binding Snacks, StringFormat='{0:F0}'}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Start" BackgroundColor="Transparent">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSnacksTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="kcal/week" FontSize="14" VerticalOptions="Center" HorizontalOptions="Start" TextColor="#999999"/>
                </HorizontalStackLayout>

                <!-- Change Per Week Selection (Bulk/Cut only) -->
                <HorizontalStackLayout x:Name="ChangePerWeekSection" Spacing="20" VerticalOptions="Center" HorizontalOptions="Fill" IsVisible="False">
                    <Label Text="Change Per Week:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label x:Name="ChangePerWeekDisplay" Text="{Binding ChangePerWeek, StringFormat='{0:F2}'}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="End" BackgroundColor="Transparent" TextColor="Black">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChangePerWeekTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <!-- Hidden Entry for numeric input -->
                <Entry x:Name="HiddenEntry" Keyboard="Numeric" IsVisible="False" BackgroundColor="Transparent" Opacity="0" HeightRequest="0"/>

                <!-- Results Section -->
                <Frame BorderColor="#E0E0E0" CornerRadius="12" Padding="20" HasShadow="False" Margin="0,20,0,0">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Results" FontSize="16" FontAttributes="Bold" TextColor="#666666"/>
                        
                        <!-- Daily/Average Calories -->
                        <VerticalStackLayout Spacing="8">
                            <Label x:Name="CaloriesLabelSameEveryday"
                                   Text="Daily Calories" FontSize="14" FontAttributes="Bold" TextColor="#666666"
                                   IsVisible="{Binding EatingPattern, StringFormat='{0}', ConverterParameter='Same Everyday', Converter={StaticResource EqualityConverter}}"/>
                            <Label x:Name="CaloriesLabelTrainingDays"
                                   Text="Average Daily Calories" FontSize="14" FontAttributes="Bold" TextColor="#666666"
                                   IsVisible="{Binding EatingPattern, StringFormat='{0}', ConverterParameter='Training Days', Converter={StaticResource EqualityConverter}}"/>
                            <Label FontSize="28" FontAttributes="Bold">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding DailyCalories}" TextColor="#4ECDC4"/>
                                        <Span Text=" kcal" FontSize="14" TextColor="#999999"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>

                        <!-- Daily Macros (visible when eating same everyday) -->
                        <VerticalStackLayout x:Name="DailyMacrosSection" Spacing="12" IsVisible="{Binding EatingPattern, StringFormat='{0}', ConverterParameter='Same Everyday', Converter={StaticResource EqualityConverter}}">
                            <Label Text="Daily Macros" FontSize="14" FontAttributes="Bold" TextColor="#666666"/>
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="FillAndExpand">
                                <Frame BorderColor="#4ECDC4" CornerRadius="8" Padding="12" HasShadow="False" WidthRequest="100">
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="Protein" FontSize="11" HorizontalOptions="Center" TextColor="#999999"/>
                                        <Label Text="{Binding Protein, StringFormat='{0}g'}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#4ECDC4"/>
                                    </VerticalStackLayout>
                                </Frame>
                                <Frame BorderColor="#4ECDC4" CornerRadius="8" Padding="12" HasShadow="False" WidthRequest="100">
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="Carbs" FontSize="11" HorizontalOptions="Center" TextColor="#999999"/>
                                        <Label Text="{Binding Carbs, StringFormat='{0}g'}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#4ECDC4"/>
                                    </VerticalStackLayout>
                                </Frame>
                                <Frame BorderColor="#4ECDC4" CornerRadius="8" Padding="12" HasShadow="False" WidthRequest="100">
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="Fat" FontSize="11" HorizontalOptions="Center" TextColor="#999999"/>
                                        <Label Text="{Binding Fat, StringFormat='{0}g'}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#4ECDC4"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- Training Day Macros (conditional) -->
                        <VerticalStackLayout x:Name="TrainingDaySection" Spacing="12" IsVisible="False">
                            <Label Text="Training Days" FontSize="14" FontAttributes="Bold" TextColor="#666666"/>
                            <Label Text="{Binding TrainingDayCalories, StringFormat='Calories: {0} kcal'}" FontSize="13" TextColor="#999999"/>
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="FillAndExpand">
                                <Frame BorderColor="#4ECDC4" CornerRadius="8" Padding="12" HasShadow="False" WidthRequest="100">
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="Protein" FontSize="11" HorizontalOptions="Center" TextColor="#999999"/>
                                        <Label Text="{Binding TrainingDayProtein, StringFormat='{0}g'}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#4ECDC4"/>
                                    </VerticalStackLayout>
                                </Frame>
                                <Frame BorderColor="#4ECDC4" CornerRadius="8" Padding="12" HasShadow="False" WidthRequest="100">
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="Carbs" FontSize="11" HorizontalOptions="Center" TextColor="#999999"/>
                                        <Label Text="{Binding TrainingDayCarbs, StringFormat='{0}g'}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#4ECDC4"/>
                                    </VerticalStackLayout>
                                </Frame>
                                <Frame BorderColor="#4ECDC4" CornerRadius="8" Padding="12" HasShadow="False" WidthRequest="100">
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="Fat" FontSize="11" HorizontalOptions="Center" TextColor="#999999"/>
                                        <Label Text="{Binding TrainingDayFat, StringFormat='{0}g'}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#4ECDC4"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- Rest Day Macros (conditional) -->
                        <VerticalStackLayout x:Name="RestDaySection" Spacing="12" IsVisible="False">
                            <Label Text="Rest Days" FontSize="14" FontAttributes="Bold" TextColor="#666666"/>
                            <Label Text="{Binding RestDayCalories, StringFormat='Calories: {0} kcal'}" FontSize="13" TextColor="#999999"/>
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="FillAndExpand">
                                <Frame BorderColor="#4ECDC4" CornerRadius="8" Padding="12" HasShadow="False" WidthRequest="100">
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="Protein" FontSize="11" HorizontalOptions="Center" TextColor="#999999"/>
                                        <Label Text="{Binding RestDayProtein, StringFormat='{0}g'}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#4ECDC4"/>
                                    </VerticalStackLayout>
                                </Frame>
                                <Frame BorderColor="#4ECDC4" CornerRadius="8" Padding="12" HasShadow="False" WidthRequest="100">
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="Carbs" FontSize="11" HorizontalOptions="Center" TextColor="#999999"/>
                                        <Label Text="{Binding RestDayCarbs, StringFormat='{0}g'}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#4ECDC4"/>
                                    </VerticalStackLayout>
                                </Frame>
                                <Frame BorderColor="#4ECDC4" CornerRadius="8" Padding="12" HasShadow="False" WidthRequest="100">
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="Fat" FontSize="11" HorizontalOptions="Center" TextColor="#999999"/>
                                        <Label Text="{Binding RestDayFat, StringFormat='{0}g'}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#4ECDC4"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Save/Load Buttons - Fixed at bottom above tab bar -->
        <HorizontalStackLayout Grid.Row="2" Spacing="12" Margin="0,0,20,20" HorizontalOptions="Center">
            <Button Text="Save" 
                    Clicked="OnSaveClicked"
                    BackgroundColor="#4ECDC4"
                    TextColor="White"
                    FontSize="14"
                    FontAttributes="Bold"
                    Padding="20,10"
                    WidthRequest="100"
                    CornerRadius="8"/>
            <Button Text="Load" 
                    Clicked="OnLoadClicked"
                    BackgroundColor="#4ECDC4"
                    TextColor="White"
                    FontSize="14"
                    FontAttributes="Bold"
                    Padding="20,10"
                    WidthRequest="100"
                    CornerRadius="8"/>
        </HorizontalStackLayout>

    </Grid>

</ContentPage>
