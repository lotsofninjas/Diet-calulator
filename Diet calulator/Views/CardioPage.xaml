<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Diet_calulator.Views.CardioPage"
             Title="Cardio Calculator"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*" Padding="20,20,20,0" RowSpacing="20">
        <!-- Header Row - Activity Type Selection -->
        <HorizontalStackLayout Grid.Row="0" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
            <Button x:Name="WalkingButton"
                    Text="Walking"
                    Clicked="OnActivityClicked"
                    BackgroundColor="#4ECDC4"
                    TextColor="White"
                    Padding="15,8"
                    FontSize="14"
                    FontAttributes="Bold"
                    WidthRequest="100"
                    CornerRadius="8"/>
            <Button x:Name="RunningButton"
                    Text="Running"
                    Clicked="OnActivityClicked"
                    BackgroundColor="#E8E8E8"
                    TextColor="#666666"
                    Padding="15,8"
                    FontSize="14"
                    FontAttributes="Bold"
                    WidthRequest="100"
                    CornerRadius="8"/>
            <Button x:Name="CyclingButton"
                    Text="Cycling"
                    Clicked="OnActivityClicked"
                    BackgroundColor="#E8E8E8"
                    TextColor="#666666"
                    Padding="15,8"
                    FontSize="14"
                    FontAttributes="Bold"
                    WidthRequest="100"
                    CornerRadius="8"/>
        </HorizontalStackLayout>

        <!-- Scrollable Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="0,0,20,20" Spacing="20" Margin="0,10,0,0">
                
                <!-- Weight Input -->
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center" HorizontalOptions="Start">
                    <Label Text="Weight:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" WidthRequest="80"/>
                    <Label x:Name="WeightDisplay"
                           Text="{Binding Weight, StringFormat='{0:F1}'}"
                           FontSize="16"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"
                           BackgroundColor="Transparent">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnWeightTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="WeightUnitLabel" Text="{Binding WeightUnit}" FontSize="14" VerticalOptions="Center" HorizontalOptions="Start" TextColor="#999999"/>
                </HorizontalStackLayout>

                <!-- Duration Input -->
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center" HorizontalOptions="Start">
                    <Label Text="Duration:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" WidthRequest="80"/>
                    <Label x:Name="DurationDisplay"
                           Text="{Binding Duration, StringFormat='{0}'}"
                           FontSize="16"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"
                           BackgroundColor="Transparent">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDurationTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="min" FontSize="14" VerticalOptions="Center" HorizontalOptions="Start" TextColor="#999999"/>
                </HorizontalStackLayout>

                <!-- Speed (for Walking/Running) -->
                <VerticalStackLayout x:Name="SpeedSection" IsVisible="True" Spacing="8">
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center" HorizontalOptions="Start">
                        <Label Text="Speed:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" WidthRequest="80"/>
                        <Label x:Name="SpeedDisplay"
                               Text="{Binding SpeedDisplay, StringFormat='{0:F1}'}"
                               FontSize="16"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               HorizontalOptions="Start"
                               BackgroundColor="Transparent">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSpeedTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label x:Name="SpeedUnitLabel" FontSize="14" VerticalOptions="Center" HorizontalOptions="Start" TextColor="#999999"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Incline (for Walking/Running) -->
                <VerticalStackLayout x:Name="InclineSection" IsVisible="True" Spacing="8">
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center" HorizontalOptions="Start">
                        <Label Text="Incline:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" WidthRequest="80"/>
                        <Label x:Name="InclineDisplay"
                               Text="{Binding Incline, StringFormat='{0:F1}'}"
                               FontSize="16"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               HorizontalOptions="Start"
                               BackgroundColor="Transparent">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnInclineTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="%" FontSize="14" VerticalOptions="Center" HorizontalOptions="Start" TextColor="#999999"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Watts (for Cycling) -->
                <VerticalStackLayout x:Name="WattsSection" IsVisible="False" Spacing="8">
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center" HorizontalOptions="Start">
                        <Label Text="Power:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" WidthRequest="80"/>
                        <Label x:Name="WattsDisplay"
                               Text="{Binding Watts, StringFormat='{0:F0}'}"
                               FontSize="16"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               HorizontalOptions="Start"
                               BackgroundColor="Transparent">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnWattsTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="W" FontSize="14" VerticalOptions="Center" HorizontalOptions="Start" TextColor="#999999"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Hidden Entry for numeric input -->
                <Entry x:Name="HiddenEntry" Keyboard="Numeric" IsVisible="False" BackgroundColor="Transparent" Opacity="0" HeightRequest="0"/>

                <!-- Results Section -->
                <Frame BorderColor="#E0E0E0" CornerRadius="12" Padding="20" HasShadow="False" Margin="0,20,0,0">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Calories Burned" FontSize="14" FontAttributes="Bold" TextColor="#666666"/>
                        
                        <!-- Total Calories -->
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label FontSize="32" FontAttributes="Bold" HorizontalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding CaloriesBurned, StringFormat='{0}'}" TextColor="#4ECDC4"/>
                                        <Span Text=" kcal" FontSize="14" TextColor="#999999"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Save/Load Buttons - Fixed at bottom above tab bar -->
        <HorizontalStackLayout Grid.Row="2" Spacing="12" Margin="0,0,20,20" HorizontalOptions="Center">
            <Button Text="Save" 
                    Clicked="OnSaveClicked"
                    BackgroundColor="#4ECDC4"
                    TextColor="White"
                    FontSize="14"
                    FontAttributes="Bold"
                    Padding="20,10"
                    WidthRequest="100"
                    CornerRadius="8"/>
            <Button Text="Load" 
                    Clicked="OnLoadClicked"
                    BackgroundColor="#4ECDC4"
                    TextColor="White"
                    FontSize="14"
                    FontAttributes="Bold"
                    Padding="20,10"
                    WidthRequest="100"
                    CornerRadius="8"/>
        </HorizontalStackLayout>

    </Grid>

</ContentPage>
