<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Diet_calulator.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Diet_calulator"
    xmlns:views="clr-namespace:Diet_calulator.Views"
    Title="Diet Calculator">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto" Padding="0,0,20,0" BackgroundColor="Transparent">
            <Label x:Name="TitleLabel" Text="Diet Calculator" FontSize="18" FontAttributes="Bold" VerticalOptions="Center"/>
        </Grid>
    </Shell.TitleView>

    <TabBar>
        <ShellContent
            Title="Macros"
            Icon="nutrition.png"
            ContentTemplate="{DataTemplate views:MacroPage}"
            Route="MacroPage" />
        
        <ShellContent
            Title="Metabolism"
            Icon="calculator.png"
            ContentTemplate="{DataTemplate views:MetabolismPage}"
            Route="MetabolismPage" />
        
        <ShellContent
            Title="Cardio"
            Icon="nutrition.png"
            ContentTemplate="{DataTemplate views:CardioPage}"
            Route="CardioPage" />
        
        <ShellContent
            Title="Settings"
            Icon="settings.svg"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="SettingsPage" />
    </TabBar>

</Shell>
